<?xml version="1.0" encoding="utf-8"?>
<!-- Sanitized minimal fixture derived from the live Prime Video TTML2 shape. -->
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    ttp:version="2"
    xml:lang="en-US">
  <head>
    <layout>
      <region xml:id="r0" tts:extent="100% 15%" tts:origin="0% 85%" tts:displayAlign="after" tts:textAlign="center" />
      <region xml:id="r1" tts:extent="100% 15%" tts:origin="0% 0%" tts:displayAlign="before" tts:textAlign="center" />
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00:22.708" end="00:00:24.708" region="r0">
        Alpha   &amp; <span>Beta <span> Gamma </span></span><br /> Delta   line
      </p>
      <p begin="00:00:25.000" end="00:00:27.250" region="r1">Top <span> cue </span></p>
    </div>
  </body>
</tt>
